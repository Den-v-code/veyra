# Normalize source and documentation text across platforms.
* text=auto eol=lf

*.py text eol=lf
*.pyi text eol=lf
*.md text eol=lf whitespace=-blank-at-eol
*.lean text eol=lf
*.rs text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.csv text eol=lf
*.cff text eol=lf
Makefile text eol=lf

# Preserve binary assets without text conversion.
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.zip binary
*.gz binary
*.xz binary
*.bin binary

# Exclude transient data from generated source archives.
data/tmp/ export-ignore
